{
  // Graphican — static site + a tiny API (worker/index.js) for stock photos/videos in /editor.
  // Secrets (Cloudflare dashboard → Workers & Pages → graphican → Settings → Variables and Secrets):
  //   PEXELS_KEY, PIXABAY_KEY
  "name": "graphican",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // Workers AI — translation and summaries in the PDF editor (free daily allowance)
  "ai": { "binding": "AI" },
  // Workers Logs: only our own console.log lines (client errors + download counts from /api/log), not every request.
  // Dashboard → Workers & Pages → graphican → Logs. Free plan: 200k lines/day, kept 3 days.
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "invocation_logs": false } },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // unknown URLs get /404.html with a real 404 status (links to the main tools) instead of an empty response
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/tools/translate-pdf/*", "/tools/translate-pdf"]
  }
}
