{
  // Graphican — static site + a tiny API (worker/index.js) for stock photos/videos in /editor.
  // Secrets (Cloudflare dashboard → Workers & Pages → graphican → Settings → Variables and Secrets):
  //   PEXELS_KEY, PIXABAY_KEY
  "name": "graphican",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // Workers AI — translation and summaries in the PDF editor (free daily allowance)
  "ai": { "binding": "AI" },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
